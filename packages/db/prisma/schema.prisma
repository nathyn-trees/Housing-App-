generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres, for real hosting (Vercel/serverless has no persistent disk, so
  // SQLite's local file doesn't work there). Run one locally via
  // `docker compose up -d` (see docker-compose.yml) for local dev.
  // Status/type fields below (urgency, roomType, etc.) stay plain strings
  // rather than native Postgres enums — they were originally written for
  // SQLite (no enum support there) and there's no reason to churn working
  // model code just because the datasource moved; validation already lives
  // at the application layer (see packages/shared types).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  bio             String?
  city            String?
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())

  // Every user gets a personal shareable link (/invite/{inviteCode}).
  // Signing up through it auto-creates an ACCEPTED connection to the inviter
  // instead of the normal request/accept flow — the whole point of handing
  // someone a link instead of adding them to a group chat is that you're
  // vouching for them into the graph directly.
  inviteCode   String  @unique
  invitedById  String?
  invitedBy    User?   @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[]  @relation("Invites")

  need      HousingNeed?
  offer     HousingOffer?
  lifestyle LifestyleProfile?

  vouchesGiven    Vouch[] @relation("VouchesGiven")
  vouchesReceived Vouch[] @relation("VouchesReceived")

  connectionsA ConnectionRequest[] @relation("ConnectionsA")
  connectionsB ConnectionRequest[] @relation("ConnectionsB")

  matchActionsAsA MatchAction[] @relation("MatchActionsA")
  matchActionsAsB MatchAction[] @relation("MatchActionsB")

  messagesSent     Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  reportsFiled    Report[] @relation("ReportsFiled")
  reportsReceived Report[] @relation("ReportsReceived")

  blocksMade     Block[] @relation("BlocksMade")
  blocksReceived Block[] @relation("BlocksReceived")
}

// An edge in the trust graph. Undirected in meaning (userA <-> userB) once ACCEPTED;
// userAId is always the requester at creation time.
// status: "PENDING" | "ACCEPTED"
model ConnectionRequest {
  id          String    @id @default(cuid())
  userAId     String
  userBId     String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  userA User @relation("ConnectionsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("ConnectionsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
}

// "I need a place / roommate" — the primary object in the app. Kept private by
// default; only surfaced to people within `visibility` degrees of separation.
// urgency: "FLEXIBLE" | "SOON" | "URGENT"
// roomType: "ANY" | "PRIVATE_ROOM" | "SHARED_ROOM" | "ENTIRE_PLACE"
// status: "ACTIVE" | "PAUSED" | "FOUND"
model HousingNeed {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          String
  neighborhoods String? // comma-separated, free text
  budgetMin     Int
  budgetMax     Int
  moveInDate    DateTime
  urgency       String   @default("FLEXIBLE")
  roomType      String   @default("ANY")
  amenities     String? // comma-separated, free text
  notes         String?
  visibility    Int      @default(2) // max degrees of separation this need is discoverable within
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// "I have a room / lease to share" — mirror of HousingNeed for people offering
// space rather than seeking it.
// roomType: "ANY" | "PRIVATE_ROOM" | "SHARED_ROOM" | "ENTIRE_PLACE"
// status: "ACTIVE" | "PAUSED" | "FOUND"
model HousingOffer {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          String
  neighborhood  String?
  rentAmount    Int
  availableDate DateTime
  roomType      String   @default("PRIVATE_ROOM")
  amenities     String?
  description   String?
  visibility    Int      @default(2)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Personal compatibility traits — independent of any specific housing search,
// so this lives on the user rather than on HousingNeed/HousingOffer. Optional:
// a missing profile scores as neutral rather than penalizing a match (see
// packages/shared/src/matching.ts).
// timeAtHome / hostingGuests: "RARELY" | "SOMETIMES" | "OFTEN" | "ALWAYS" (hostingGuests also allows "NEVER")
// socialStyle: "INTROVERT" | "AMBIVERT" | "EXTROVERT"
model LifestyleProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cleanliness   Int // 1 (relaxed) – 5 (very tidy)
  timeAtHome    String // how often they're home
  hostingGuests String // how often they have people over
  socialStyle   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A trust signal: "I know this person and can vouch for them as a roommate."
model Vouch {
  id        String   @id @default(cuid())
  voucherId String
  targetId  String
  note      String
  createdAt DateTime @default(now())

  voucher User @relation("VouchesGiven", fields: [voucherId], references: [id], onDelete: Cascade)
  target  User @relation("VouchesReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([voucherId, targetId])
}

// Records a user's reaction to a suggested match so it can be excluded/promoted
// on future computations (matches themselves are computed on demand, not stored).
// action: "INTERESTED" | "PASSED"
model MatchAction {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  actorId   String
  action    String
  createdAt DateTime @default(now())

  userA User @relation("MatchActionsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("MatchActionsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId, actorId])
}

// Direct messages, unlocked once two people are connected or have mutually
// marked each other "interested" (see canMessage in apps/web/lib/messages.ts).
model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  sender    User @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
}

// Single-use, expiring token for the forgot-password flow. The reset link is
// only ever logged server-side (see apps/web/lib/mailer.ts) — an MVP stand-in
// for a real email provider, never returned in an API response.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Same pattern as PasswordResetToken, for the (non-blocking) "verify your
// email" nudge.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A safety report filed by one user against another.
// reason: "harassment" | "scam" | "no_show" | "fake_profile" | "other"
// status: "OPEN" | "REVIEWED"
model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetId   String
  reason     String
  details    String?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())

  reporter User @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User @relation("ReportsReceived", fields: [targetId], references: [id], onDelete: Cascade)
}

// Blocking removes any existing connection and hides both people from each
// other everywhere (matches, search, messaging) — see apps/web/lib/blocks.ts.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}
